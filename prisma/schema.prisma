generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                    Int           @id @default(autoincrement())
  email                 String        @unique
  isAdmin               Boolean       @default(false)
  active                Boolean       @default(true)
  privacyAccepted       Boolean       @default(false)
  privacyAcceptedAt     DateTime?
  marketingAccepted     Boolean       @default(false)
  marketingAcceptedAt   DateTime?
  marketingRevokedAt    DateTime?
  createdAt             DateTime      @default(now())
  domains               Domain[]
  loginCodes            LoginCode[]
  consentLogs           ConsentLog[]
}

model ConsentLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "privacy" | "marketing"
  action    String   // "accepted" | "revoked"
  createdAt DateTime @default(now())
}

model LoginCode {
  id        Int      @id @default(autoincrement())
  code      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Domain {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("pending")
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  pages     Page[]
  links     Link[]
  redirects  String?
  expiryDate String?
  registrant String?
  isOption   Boolean @default(false)
  sslIssuer  String?
  sslExpiry  String?
  sslValid   Boolean @default(false)
  webpSupported Boolean @default(false)
}

model Page {
  id              Int      @id @default(autoincrement())
  url             String
  domainId        Int
  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  statusCode      Int
  title           String?
  metaDescription String?
  canonical       String?
  h1s             String?
  h2s             String?
  multipleTitleTags Boolean @default(false)
  noindex         Boolean @default(false)
  images          Image[]
  links           Link[]
  crawledAt       DateTime @default(now())
}

model Image {
  id       Int    @id @default(autoincrement())
  url      String
  size     Int?
  pageId   Int
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Link {
  id         Int    @id @default(autoincrement())
  url        String
  statusCode Int?
  pageId     Int?
  page       Page?  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  domainId   Int?
  domain     Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
}
